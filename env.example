# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
CLIENT_URL=
API_URL=


# ── Database ────────────────────────────────────────────────────────────
MONGO_URI=


# ── JWT ─────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=1

JWT_REFRESH_SECRET= 
JWT_REFRESH_EXPIRY=

# Separate from the two secrets above on purpose — see docs/known-risks.md
# for context if that ever seems worth "simplifying".
JWT_EMAIL_VERIFICATION_SECRET=
JWT_EMAIL_VERIFICATION_EXPIRY=24h

# ── Cookies ─────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost

# ── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── GitHub OAuth ────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=Ov23li7VzAMLUxccoCWG
GITHUB_CLIENT_SECRET=7eebecc6765701c6dad30b41b171e785b8db6462
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback

# ── LinkedIn OAuth ──────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=


# ── Email (optional in dev — logs to console if unset) ────────────────
